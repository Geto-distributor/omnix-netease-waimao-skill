{
  "openapi": "3.0.1",
  "paths": {
    "/api/NeteaseWaimao/v2/search/jobs": {
      "post": {
        "operationId": "CreateSearchJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/SearchJobRequest"}}
          }
        }
      }
    },
    "/api/NeteaseWaimao/v2/search/jobs/{publicJobRef}": {
      "parameters": [
        {
          "name": "publicJobRef",
          "in": "path",
          "required": true,
          "schema": {"type": "string", "pattern": "^pub_job_[A-Za-z0-9]+$"}
        }
      ],
      "get": {"operationId": "GetSearchJob"},
      "delete": {"operationId": "CancelSearchJob"}
    },
    "/api/NeteaseWaimao/v2/search/jobs/{publicJobRef}/results": {
      "parameters": [
        {
          "name": "publicJobRef",
          "in": "path",
          "required": true,
          "schema": {"type": "string", "pattern": "^pub_job_[A-Za-z0-9]+$"}
        }
      ],
      "get": {
        "operationId": "GetSearchResults",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": true,
            "schema": {"type": "integer", "minimum": 1}
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        ]
      }
    },
    "/api/NeteaseWaimao/v2/company-details/jobs": {
      "post": {
        "operationId": "CreateCompanyDetailsJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CompanyDetailsRequest"}
            }
          }
        }
      }
    },
    "/api/NeteaseWaimao/v2/search/jobs/{jobId}": {
      "get": {"operationId": "UnsafeInternalJob"}
    },
    "/api/NeteaseWaimao/v2/admin/sessions": {
      "get": {"operationId": "UnsafeAdmin"}
    }
  },
  "components": {
    "schemas": {
      "SearchJobRequest": {
        "type": "object",
        "required": ["countryCode", "keywords"],
        "additionalProperties": false,
        "properties": {
          "countryCode": {"type": "string", "minLength": 2, "maxLength": 2},
          "keywords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1}
          }
        }
      },
      "CompanyDetailsRequest": {
        "type": "object",
        "required": ["public_result_ref"],
        "additionalProperties": false,
        "properties": {
          "public_result_ref": {"type": "string", "pattern": "^pub_result_[A-Za-z0-9]+$"}
        }
      }
    }
  }
}
